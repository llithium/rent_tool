# Both keys are OPTIONAL. Off-list cities already get rent figures from the bundled
# county-level HUD FMR table (src/lib/data/fmr-county.json) — keys only upgrade freshness.

# HUD Fair Market Rents API token (FREE): switches /api/fmr from the bundled FY2026
# table to live figures. https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_TOKEN=

# US Census API key (FREE): enables the ACS median-gross-rent fallback (the Census API
# rejects keyless requests). https://api.census.gov/data/key_signup.html
CENSUS_KEY=
